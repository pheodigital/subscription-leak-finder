# ─────────────────────────────
# Dependencies
# ─────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─────────────────────────────
# Environment variables & secrets
# NEVER commit these — API keys, DB URLs, bot tokens etc live here
# ─────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem

# ─────────────────────────────
# Next.js (frontend/)
# ─────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
.next/
out/

# ─────────────────────────────
# Fastify / Node backend (backend/)
# ─────────────────────────────
backend/dist/
backend/build/
dist/
build/

# ─────────────────────────────
# Logs
# ─────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────
# Testing / coverage
# ─────────────────────────────
coverage/
.nyc_output/

# ─────────────────────────────
# TypeScript
# ─────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────────
# Docker
# n8n and Ollama data volumes should never be committed —
# they contain local workflow data / model weights / DB state
# ─────────────────────────────
n8n_data/
ollama_data/
docker/volumes/
*.pid

# ─────────────────────────────
# Database (Drizzle / local Postgres dumps, if any)
# ─────────────────────────────
*.sqlite
*.sqlite3
drizzle/meta/
*.dump

# ─────────────────────────────
# OS files
# ─────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─────────────────────────────
# Editor / IDE
# ─────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─────────────────────────────
# Vercel / Railway local config
# ─────────────────────────────
.vercel
.railway

# ─────────────────────────────
# Misc
# ─────────────────────────────
*.tgz
.turbo/
.cache/